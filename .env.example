# Copy to .env and adjust. Values below are DEVELOPMENT-ONLY defaults.
# Never use these in production. Never commit .env.

NODE_ENV=development

# Gateway listeners
PORT=8080
HTTPS_PORT=8443
TLS_ENABLED=false
TLS_CERT_PATH=.local/certs/server.crt
TLS_KEY_PATH=.local/certs/server.key
HTTPS_REDIRECT=false

# PostgreSQL (development-only credentials)
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth (development-only secret; generate a strong one for any shared environment)
JWT_SECRET=dev-only-change-me-in-any-shared-environment
JWT_EXPIRES_IN=15m
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=admin123

# Trusted proxy settings: controls whether X-Forwarded-For is honored.
# Comma-separated CIDRs or "loopback", "uniquewide". Default trusts nothing.
TRUSTED_PROXIES=

# Rate limiting
RATE_LIMIT_FAIL_OPEN=true
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW_MS=60000

# Upstream SSRF policy
# Comma-separated hostnames that bypass private-IP blocking (development only).
# Example: users-service,orders-service for docker compose networking.
SSRF_DEV_ALLOWLIST=users-service,orders-service,slow-service,failing-service,localhost,127.0.0.1,::1

# Timeouts (ms)
UPSTREAM_CONNECT_TIMEOUT_MS=5000
UPSTREAM_RESPONSE_TIMEOUT_MS=30000

# Request limits
MAX_BODY_BYTES=1048576
MAX_HEADER_BYTES=8192

# Observability
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_PATH=/internal/metrics

# Admin UI
ADMIN_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
