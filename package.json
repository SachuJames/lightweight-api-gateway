{
  "description": "A programmable, extensible HTTP API gateway built with Node.js, Fastify, Redis, PostgreSQL, React, and Docker.",
  "devDependencies": {
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "name": "lightweight-api-gateway",
  "packageManager": "pnpm@10.34.6",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter gateway db:migrate",
    "db:reset": "pnpm --filter gateway db:reset",
    "db:seed": "pnpm --filter gateway db:seed",
    "dev": "pnpm --filter gateway dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter gateway test:integration",
    "test:unit": "pnpm --filter gateway test:unit",
    "tls:generate": "bash scripts/generate-dev-certs.sh",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "version": "0.1.0"
}
